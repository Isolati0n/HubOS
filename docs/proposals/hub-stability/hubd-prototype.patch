--- a/internal/hub/restore_proto.go
+++ b/internal/hub/restore_proto.go
@@ -0,0 +1,93 @@
+package hub
+
+import (
+	"context"
+	"os"
+	"time"
+)
+
+// HUB-STABILITY PROTOTYPE (research only, not for merge): after driftwm
+// restarts (the event stream ended while hubd kept running), relaunch the
+// viewers of the machines that were open, through driftwm's own stand-ins.
+// Mode comes from HUBD_PROTO_RESTORE: "" = off, "all" = ask for all relaunches
+// at once, "stagger" = one at a time, each after the previous one is recorded.
+
+func (h *Hub) openMachines() []string {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	var ids []string
+	for _, s := range h.ms {
+		if s.win != nil {
+			ids = append(ids, s.m.ID)
+		}
+	}
+	return ids
+}
+
+type relauncher interface{ Relaunch(id int) error }
+
+func (h *Hub) restore(ctx context.Context, want []string) {
+	mode := os.Getenv("HUBD_PROTO_RESTORE")
+	rl, ok := h.comp.(relauncher)
+	if mode == "" || !ok || len(want) == 0 {
+		return
+	}
+	if mode == "direct" {
+		// No stand-ins needed: hubd saved each window's place itself; open every
+		// machine that was open, all at once, and put the new window back.
+		for _, id := range want {
+			h.mu.Lock()
+			if s := h.byID[id]; s != nil && s.lastGeom != nil {
+				g := *s.lastGeom
+				s.restoreGeom = &g
+			}
+			h.mu.Unlock()
+			go h.Open(id)
+		}
+		return
+	}
+	// The signal we wait for: a stand-in for every machine that was open
+	// (driftwm restores them before it answers IPC) -- or 10 s.
+	deadline := time.Now().Add(10 * time.Second)
+	standin := map[string]int{}
+	for time.Now().Before(deadline) && ctx.Err() == nil {
+		st, err := h.comp.State()
+		if err == nil {
+			standin = map[string]int{}
+			for _, w := range st.Windows {
+				if w.Suspended {
+					standin[w.AppID] = w.ID
+				}
+			}
+			n := 0
+			for _, id := range want {
+				if _, ok := standin["hubos-"+id]; ok {
+					n++
+				}
+			}
+			if n == len(want) {
+				break
+			}
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	for _, id := range want {
+		sid, ok := standin["hubos-"+id]
+		if !ok {
+			continue
+		}
+		_ = rl.Relaunch(sid)
+		if mode == "stagger" {
+			t := time.Now()
+			for time.Since(t) < 10*time.Second {
+				h.mu.Lock()
+				done := h.byID[id].win != nil
+				h.mu.Unlock()
+				if done {
+					break
+				}
+				time.Sleep(20 * time.Millisecond)
+			}
+		}
+	}
+}
