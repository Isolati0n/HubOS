libseat1
libinput10
libinput-bin
libudev1
libwayland-client0
libwayland-server0
libwayland-egl1
libxkbcommon0
xkb-data
libdrm2
libgbm1
libegl1
libegl-mesa0
libgles2
libgl1-mesa-dri
libglx-mesa0
mesa-vulkan-drivers
libvulkan1
libpixman-1-0
libdisplay-info1
libfontconfig1
fontconfig-config
fonts-dejavu-core
foot
foot-terminfo
wayland-utils
waybar
dbus-daemon
jq
fonts-font-awesome
libinput-tools
wofi
