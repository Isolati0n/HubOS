Hub OS P8: start-up shell-outs are time-boxed (3 s, then killed) instead of waited for for ever; the environment
variables whose values are known at start are set before the first thread starts.

diff -ruN a/src/bounded.rs b/src/bounded.rs
--- /dev/null
+++ b/src/bounded.rs
@@ -0,0 +1,55 @@
+//! Bounded waiting for a child process (Hub OS patch P8).
+//!
+//! The start-up shell-outs (`systemctl --user import-environment`,
+//! `dbus-update-activation-environment`, the xwayland-satellite probe) were
+//! waited for with `Child::wait()` on the main thread before the event loop
+//! runs: if the program hangs, the compositor never starts. These helpers wait
+//! for a limited time and then kill the child.
+
+use std::process::Child;
+use std::time::{Duration, Instant};
+
+/// How long a start-up shell-out may take before it is killed.
+pub const STARTUP_SHELLOUT_LIMIT: Duration = Duration::from_secs(3);
+
+/// Wait for `child` for at most `limit`. Returns `Some(success)` when it
+/// finished (a wait error counts as finished, unsuccessful), `None` when the
+/// limit passed; then the child is killed and reaped.
+pub fn wait_bounded(child: &mut Child, limit: Duration) -> Option<bool> {
+    let end = Instant::now() + limit;
+    loop {
+        match child.try_wait() {
+            Ok(Some(status)) => return Some(status.success()),
+            Ok(None) => {}
+            Err(_) => return Some(false),
+        }
+        if Instant::now() >= end {
+            let _ = child.kill();
+            let _ = child.wait();
+            return None;
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::process::Command;
+
+    #[test]
+    fn a_quick_child_finishes() {
+        let mut c = Command::new("/bin/sh").args(["-c", "exit 0"]).spawn().unwrap();
+        assert_eq!(wait_bounded(&mut c, Duration::from_secs(5)), Some(true));
+        let mut c = Command::new("/bin/sh").args(["-c", "exit 3"]).spawn().unwrap();
+        assert_eq!(wait_bounded(&mut c, Duration::from_secs(5)), Some(false));
+    }
+
+    #[test]
+    fn a_hanging_child_is_killed_at_the_limit() {
+        let mut c = Command::new("/bin/sh").args(["-c", "sleep 30"]).spawn().unwrap();
+        let t = Instant::now();
+        assert_eq!(wait_bounded(&mut c, Duration::from_millis(200)), None);
+        assert!(t.elapsed() < Duration::from_secs(5));
+    }
+}
