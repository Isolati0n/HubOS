+/// Like [`write`], but the file is written by a worker thread (Hub OS patch P11):
+/// the caller only serializes and returns at once, so a stalled disk cannot
+/// freeze the event loop. Never fsync'd.
+pub fn write_async(path: &Path, envelope: &SessionEnvelope) -> std::io::Result<()> {
+    let json = serde_json::to_string_pretty(envelope)?;
+    crate::bgwrite::submit(path.to_path_buf(), json.into_bytes());
+    Ok(())
+}
+
