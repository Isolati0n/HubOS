--- /dev/null
+++ b/src/bgwrite.rs
@@ -0,0 +1,249 @@
+//! Files written by a worker thread (Hub OS patch P11).
+//!
+//! driftwm wrote its session file and its runtime state file on the event-loop
+//! thread. If the disk (or whatever the folder is on) stalls, `open`/`write`/
+//! `rename` block and the whole compositor freezes. Here the event loop only
+//! hands the finished bytes over (`submit`, never waits); one worker thread does
+//! the write (temporary file, then rename). Only the newest bytes for a path are
+//! kept: if the worker is stuck, later submissions replace the waiting one, so
+//! memory does not grow. Standard library only.
+//!
+//! [`set_inline`] makes [`submit`] write on the calling thread; the compositor's
+//! own tests use it, so they can read the file right after a write.
+
+use std::collections::HashMap;
+use std::io::Write as _;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Condvar, Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+struct Inner {
+    pending: HashMap<PathBuf, Vec<u8>>,
+    busy: bool,
+}
+
+struct Shared {
+    inner: Mutex<Inner>,
+    cv: Condvar,
+}
+
+/// A worker thread and its mailbox.
+#[derive(Clone)]
+pub struct Writer {
+    shared: Arc<Shared>,
+    /// Writes that ended with an error (counted by the worker).
+    failed: Arc<AtomicU64>,
+}
+
+/// Write `bytes` to `path` atomically: parent folder, `path.tmp`, rename.
+pub fn write_atomic(path: &Path, bytes: &[u8]) -> std::io::Result<()> {
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    let mut tmp = path.as_os_str().to_owned();
+    tmp.push(".tmp");
+    let tmp = PathBuf::from(tmp);
+    let mut file = std::fs::File::create(&tmp)?;
+    file.write_all(bytes)?;
+    drop(file);
+    std::fs::rename(&tmp, path)
+}
+
+impl Writer {
+    pub fn new() -> Writer {
+        let shared = Arc::new(Shared {
+            inner: Mutex::new(Inner::default()),
+            cv: Condvar::new(),
+        });
+        let worker = shared.clone();
+        let failed = Arc::new(AtomicU64::new(0));
+        let worker_failed = failed.clone();
+        let _ = std::thread::Builder::new()
+            .name("driftwm-files".into())
+            .spawn(move || loop {
+                let (path, bytes) = {
+                    let mut g = worker.inner.lock().unwrap_or_else(|e| e.into_inner());
+                    loop {
+                        if let Some(p) = g.pending.keys().next().cloned() {
+                            let b = g.pending.remove(&p).unwrap_or_default();
+                            g.busy = true;
+                            break (p, b);
+                        }
+                        g = worker.cv.wait(g).unwrap_or_else(|e| e.into_inner());
+                    }
+                };
+                // May block for ever on a stalled disk: only this thread waits.
+                if let Err(e) = write_atomic(&path, &bytes) {
+                    worker_failed.fetch_add(1, Ordering::Relaxed);
+                    tracing::warn!("failed to write {}: {e}", path.display());
+                }
+                let mut g = worker.inner.lock().unwrap_or_else(|e| e.into_inner());
+                g.busy = false;
+                worker.cv.notify_all();
+            });
+        Writer { shared, failed }
+    }
+
+    /// How many writes ended with an error since the start.
+    pub fn failed(&self) -> u64 {
+        self.failed.load(Ordering::Relaxed)
+    }
+
+    /// Writes waiting plus the one in progress (a stuck disk shows as a number that does not go down).
+    pub fn pending(&self) -> u64 {
+        let g = self.shared.inner.lock().unwrap_or_else(|e| e.into_inner());
+        g.pending.len() as u64 + u64::from(g.busy)
+    }
+
+    /// Queue `bytes` for `path`, replacing any older bytes still waiting for it.
+    pub fn submit(&self, path: PathBuf, bytes: Vec<u8>) {
+        let mut g = self.shared.inner.lock().unwrap_or_else(|e| e.into_inner());
+        g.pending.insert(path, bytes);
+        self.shared.cv.notify_all();
+    }
+
+    /// Wait until nothing is queued or being written, at most `timeout`.
+    pub fn flush_for(&self, timeout: Duration) {
+        let end = Instant::now() + timeout;
+        let mut g = self.shared.inner.lock().unwrap_or_else(|e| e.into_inner());
+        while !g.pending.is_empty() || g.busy {
+            let now = Instant::now();
+            if now >= end {
+                return;
+            }
+            g = self
+                .shared
+                .cv
+                .wait_timeout(g, end - now)
+                .unwrap_or_else(|e| e.into_inner())
+                .0;
+        }
+    }
+}
+
+impl Default for Writer {
+    fn default() -> Self {
+        Writer::new()
+    }
+}
+
+static GLOBAL: OnceLock<Writer> = OnceLock::new();
+
+static INLINE: AtomicBool = AtomicBool::new(false);
+static INLINE_FAILED: AtomicU64 = AtomicU64::new(0);
+
+/// Make [`submit`] write on the calling thread (used by the compositor's own
+/// tests, which read the file right after a write). Never set in the compositor.
+pub fn set_inline(on: bool) {
+    INLINE.store(on, Ordering::Relaxed);
+}
+
+/// Hand `bytes` for `path` to the worker thread. Never blocks.
+pub fn submit(path: PathBuf, bytes: Vec<u8>) {
+    if INLINE.load(Ordering::Relaxed) {
+        if write_atomic(&path, &bytes).is_err() {
+            INLINE_FAILED.fetch_add(1, Ordering::Relaxed);
+        }
+        return;
+    }
+    GLOBAL.get_or_init(Writer::new).submit(path, bytes);
+}
+
+/// Background writes that failed since the start (shown in the IPC `state` reply).
+pub fn failed_writes() -> u64 {
+    INLINE_FAILED.load(Ordering::Relaxed) + GLOBAL.get().map_or(0, Writer::failed)
+}
+
+/// Background writes waiting or in progress (shown in the IPC `state` reply).
+pub fn pending_writes() -> u64 {
+    GLOBAL.get().map_or(0, Writer::pending)
+}
+
+/// Give the worker up to `timeout` to finish what is queued (call before exit).
+pub fn flush_for(timeout: Duration) {
+    if let Some(w) = GLOBAL.get() {
+        w.flush_for(timeout);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::FileTypeExt as _;
+
+    fn tmpdir(name: &str) -> PathBuf {
+        let d = std::env::temp_dir().join(format!("bgwrite-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&d);
+        std::fs::create_dir_all(&d).unwrap();
+        d
+    }
+
+    #[test]
+    fn a_normal_write_arrives() {
+        let d = tmpdir("ok");
+        let w = Writer::new();
+        w.submit(d.join("sub/file"), b"hello".to_vec());
+        w.flush_for(Duration::from_secs(5));
+        assert_eq!(std::fs::read(d.join("sub/file")).unwrap(), b"hello");
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    #[test]
+    fn a_failed_write_is_counted() {
+        let d = tmpdir("fail");
+        // the temporary name is a directory: File::create fails at once
+        std::fs::create_dir_all(d.join("session.json.tmp")).unwrap();
+        let w = Writer::new();
+        assert_eq!(w.failed(), 0);
+        w.submit(d.join("session.json"), b"x".to_vec());
+        w.flush_for(Duration::from_secs(5));
+        assert_eq!(w.failed(), 1);
+        assert_eq!(w.pending(), 0);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    #[test]
+    fn a_stuck_write_shows_as_pending() {
+        let d = tmpdir("stuck");
+        let mut tmp = d.join("s.json").into_os_string();
+        tmp.push(".tmp");
+        let tmp = PathBuf::from(tmp);
+        let c = std::ffi::CString::new(tmp.to_str().unwrap()).unwrap();
+        assert_eq!(unsafe { libc::mkfifo(c.as_ptr(), 0o600) }, 0);
+        let w = Writer::new();
+        w.submit(d.join("s.json"), b"x".to_vec());
+        std::thread::sleep(Duration::from_millis(200));
+        assert_eq!(w.pending(), 1); // the worker is blocked in open(2) on the FIFO
+        assert_eq!(w.failed(), 0);
+        let _reader = std::fs::File::open(&tmp);
+        w.flush_for(Duration::from_secs(5));
+        assert_eq!(w.pending(), 0);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    #[test]
+    fn a_blocked_write_never_blocks_the_caller_and_the_newest_bytes_win() {
+        let d = tmpdir("fifo");
+        // the temporary name is a FIFO nobody reads: open(2) for writing blocks
+        let mut tmp = d.join("session.json").into_os_string();
+        tmp.push(".tmp");
+        let tmp = PathBuf::from(tmp);
+        let c = std::ffi::CString::new(tmp.to_str().unwrap()).unwrap();
+        assert_eq!(unsafe { libc::mkfifo(c.as_ptr(), 0o600) }, 0);
+        assert!(std::fs::metadata(&tmp).unwrap().file_type().is_fifo());
+        let w = Writer::new();
+        let t = Instant::now();
+        for i in 0..1000 {
+            w.submit(d.join("session.json"), format!("{i}").into_bytes());
+        }
+        assert!(t.elapsed() < Duration::from_secs(1));
+        // a different path is stuck behind the blocked one (one worker) but the caller still never waits
+        w.flush_for(Duration::from_millis(100));
+        // unblock the worker: open the FIFO for reading, so it can finish
+        let _reader = std::fs::File::open(&tmp);
+        w.flush_for(Duration::from_secs(5));
+        let _ = std::fs::remove_dir_all(&d);
+    }
+}
