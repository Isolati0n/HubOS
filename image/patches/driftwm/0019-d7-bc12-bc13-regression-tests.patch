+    // HUB-OS PATCH D7: regression tests for BC-13 (an IPC `Move` of a window to y = 2147483647, then any navigation
+    // action such as `center-nearest left`: `closest_point_on_rect` added `loc + size` in 32 bits, the sum wrapped
+    // negative and `f64::clamp` panicked with "min > max", which is checked in release builds too). The live
+    // reproduction is `repro_ipc.py ... nav_far` (tools/image/experiments/driftwm-patches/).
+    #[test]
+    fn bc13_closest_point_on_a_window_at_the_edge_of_i32() {
+        let origin = cam(0.0, 0.0);
+        let p = closest_point_on_rect(origin, Point::from((65535, i32::MAX)), vp(800, 600));
+        assert_eq!(p.x, 65535.0);
+        assert_eq!(p.y, i32::MAX as f64);
+        let p = closest_point_on_rect(origin, Point::from((i32::MAX, i32::MAX)), vp(i32::MAX, i32::MAX));
+        assert_eq!((p.x, p.y), (i32::MAX as f64, i32::MAX as f64));
+        let p = closest_point_on_rect(cam(1e12, -1e12), Point::from((i32::MIN, i32::MIN)), vp(i32::MAX, i32::MAX));
+        assert!(p.x.is_finite() && p.y.is_finite());
+    }
