+    // HUB-OS PATCH D7: regression tests for BC-12 (an IPC `Resize` of a stand-in to 32768 x 32768 or more made
+    // `render_body_fill` compute `(w * h * 4) as usize` in 32 bits; it wrapped and the compositor died with
+    // "capacity overflow"). The live-compositor reproduction is `repro_ipc.py ... standin_resize_32768`
+    // (tools/image/experiments/driftwm-patches/).
+    fn buffer_bytes(buf: &mut MemoryRenderBuffer) -> usize {
+        let mut n = 0;
+        buf.render()
+            .draw(|pixels| {
+                n = pixels.len();
+                Ok::<_, std::convert::Infallible>(Vec::new())
+            })
+            .unwrap();
+        n
+    }
+
+    #[test]
+    fn bc12_huge_stand_in_body_fill_is_clamped_not_a_crash() {
+        let config = DecorationConfig::default();
+        for (w, h) in [(32768, 32768), (65535, 65535), (i32::MAX, i32::MAX), (1, i32::MAX)] {
+            let mut buf = render_body_fill(w, h, 1, &config);
+            assert!(buffer_bytes(&mut buf) <= 8192 * 8192 * 4, "{w}x{h}: the fill must stay at or below 256 MB");
+        }
+    }
+
+    #[test]
+    fn bc12_huge_stand_in_title_bar_is_clamped_not_a_crash() {
+        let config = DecorationConfig::default();
+        for w in [32768, 65535, 2_000_000_000, i32::MAX] {
+            let mut buf = render_title_bar(w, true, false, 1, "x", false, 0, &config);
+            assert!(buffer_bytes(&mut buf) <= 16384 * 4 * 1024, "width {w}: the bar must stay at or below 16384 pixels wide");
+        }
+    }
