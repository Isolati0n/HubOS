+    // HUB-STABILITY PATCH: with --wayland-fd the socket was bound by a parent
+    // (wl-restart style) and stays open across compositor restarts; we only
+    // accept on it. Without it, behave exactly as upstream.
+    enum Listener {
+        Own(smithay::wayland::socket::ListeningSocketSource),
+        Inherited(std::os::unix::net::UnixListener),
+    }
+    let (listening_socket, socket_name) = if let Some(fd) = cli.wayland_fd {
+        use std::os::fd::FromRawFd;
+        let name = cli
+            .socket
+            .clone()
+            .ok_or("--wayland-fd needs --socket NAME")?;
+        // SAFETY: the parent passed a listening unix socket as this fd.
+        let l = unsafe { std::os::unix::net::UnixListener::from_raw_fd(fd) };
+        l.set_nonblocking(true)?;
+        // Do not leak the listening socket into apps we spawn.
+        unsafe { libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC) };
+        (Listener::Inherited(l), name)
+    } else {
+        let s = smithay::wayland::socket::ListeningSocketSource::new_auto()?;
+        let n = s.socket_name().to_string_lossy().into_owned();
+        (Listener::Own(s), n)
+    };
     tracing::info!("Listening on WAYLAND_DISPLAY={socket_name}");
     unsafe { std::env::set_var("WAYLAND_DISPLAY", &socket_name) };
     unsafe { std::env::set_var("XDG_SESSION_TYPE", "wayland") };
