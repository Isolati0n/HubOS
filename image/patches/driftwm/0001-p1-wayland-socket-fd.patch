+    match listening_socket {
+        Listener::Own(listening_socket) => {
+            event_loop
+                .handle()
+                .insert_source(listening_socket, |stream, _, data: &mut DriftWm| {
+                    tracing::info!("New client connected");
+                    if let Err(e) = data
+                        .display_handle
+                        .insert_client(stream, Arc::new(ClientState::default()))
+                    {
+                        tracing::warn!("Failed to insert client: {e}");
+                    }
+                })?;
+        }
+        Listener::Inherited(listener) => {
+            use smithay::reexports::calloop::{Interest, Mode, PostAction, generic::Generic};
+            event_loop.handle().insert_source(
+                Generic::new(listener, Interest::READ, Mode::Level),
+                |_, listener, data: &mut DriftWm| {
+                    loop {
+                        match listener.accept() {
+                            Ok((stream, _)) => {
+                                tracing::info!("New client connected (inherited socket)");
+                                if let Err(e) = data
+                                    .display_handle
+                                    .insert_client(stream, Arc::new(ClientState::default()))
+                                {
+                                    tracing::warn!("Failed to insert client: {e}");
+                                }
+                            }
+                            Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => break,
+                            Err(e) => {
+                                tracing::warn!("accept on inherited socket: {e}");
+                                break;
+                            }
+                        }
+                    }
+                    Ok(PostAction::Continue)
+                },
