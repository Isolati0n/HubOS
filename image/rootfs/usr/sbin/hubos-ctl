#!/bin/sh
# hubos-ctl: boot entries, update, confirm. Slice 1 proposal (POSIX sh); not a decision.
# Subcommands:  status | ensure-entries | update BASE | confirm
PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DISK=${HUBOS_DISK:-/dev/vda}
PUB=/etc/hubos/update.pub
STATE=/config/hubos/state
SLOT=$(cat /run/hubos-slot 2>/dev/null)
OTHER=a; [ "$SLOT" = a ] && OTHER=b
RUNVER=$(sed -n 's/^version=//p' /etc/hubos-release)
die() { echo "hubos-ctl: $*" >&2; exit 2; }

entry_num() { efibootmgr 2>/dev/null | sed -n "s/^Boot\([0-9A-F]\{4\}\)\*\{0,1\}[[:space:]]$1[[:space:]].*/\1/p" | head -1; }

# BootOrder with the recovery entry directly after the two slot entries (firmware entries keep their place after it).
order_with_rec() {
  rn=$(entry_num hubos-recovery); a=$(entry_num hubos-a); b=$(entry_num hubos-b)
  out=; rest=
  for e in $(efibootmgr 2>/dev/null | sed -n 's/^BootOrder: //p' | tr ',' ' '); do
    case $e in
      "$rn") ;;
      "$a"|"$b") out="$out,$e" ;;
      *) rest="$rest,$e" ;;
    esac
  done
  echo "${out#,},$rn$rest"
}

ensure_entries() {
  [ -d /sys/firmware/efi/efivars ] || die "no EFI variables (not booted by UEFI?)"
  # None of the three entries carries load options. The a and b entries boot kernel-a.efi and kernel-b.efi, which
  # have their slot and root built into their own command lines. The recovery entry ALWAYS boots the separate
  # recovery kernel (kernel-recovery.efi), which needs neither slot's root. The recovery entry sits in BootOrder
  # directly after the two slot entries, so the firmware keeps it (docs/image.md).
  # Creating an entry puts it first in BootOrder, so remember the order and put it back afterwards.
  oldorder=$(efibootmgr 2>/dev/null | sed -n 's/^BootOrder: //p')
  created=
  for s in a b; do
    [ -n "$(entry_num hubos-$s)" ] && continue
    efibootmgr -q -c -d $DISK -p 1 -L hubos-$s -l "\\EFI\\hubos\\kernel-$s.efi" || die "cannot create entry $s"
    created=1
  done
  rn=$(entry_num hubos-recovery)
  if [ -n "$rn" ] && ! efibootmgr -v 2>/dev/null | grep "^Boot$rn" | grep -q 'kernel-recovery\.efi'; then
    efibootmgr -q -B -b "$rn" || die "cannot delete the old recovery entry"; rn=; created=1   # made by an earlier image: re-point it
  fi
  [ -n "$rn" ] || { efibootmgr -q -c -d $DISK -p 1 -L hubos-recovery -l "\\EFI\\hubos\\kernel-recovery.efi" || die "cannot create recovery entry"; created=1; }
  rn=$(entry_num hubos-recovery)
  if [ -z "$created" ] && echo "$oldorder" | grep -q "$rn"; then return 0; fi
  a=$(entry_num hubos-a); b=$(entry_num hubos-b)
  if [ -n "$oldorder" ] && echo "$oldorder" | grep -q "$a" && echo "$oldorder" | grep -q "$b"; then
    efibootmgr -q -o "$(echo "$oldorder" | sed "s/$rn,\{0,1\}//; s/,$//")" || die "cannot restore BootOrder"   # a confirmed order exists: keep it
    efibootmgr -q -o "$(order_with_rec)" || die "cannot put the recovery entry into BootOrder"
  else
    efibootmgr -q -o "$(entry_num hubos-$SLOT),$(entry_num hubos-$OTHER),$rn"  # first install: the running slot first, recovery last
  fi
}

status() {
  echo "slot=$SLOT release=$RUNVER"; efibootmgr 2>/dev/null | sed -n '/^Boot\(Current\|Next\|Order\)/p; /^Boot[0-9A-F]*\*\{0,1\}[[:space:]]hubos/s/\t.*//p'
  echo "min_version=$(cat $STATE/min_version 2>/dev/null || echo none)"
}

fetch() { # fetch BASE NAME DEST
  case "$1" in
    http://*) wget -q -O "$3" "$1/$2" || return 1 ;;
    *)        cp "$1/$2" "$3" || return 1 ;;
  esac
}

update() {
  BASE=$1; [ -n "$BASE" ] || die "usage: hubos-ctl update BASE"
  [ -n "$SLOT" ] && [ "$SLOT" != unknown ] || die "running slot unknown"
  W=/data/update; rm -rf $W; mkdir -p $W
  echo "update: fetching manifest from $BASE"
  fetch "$BASE" manifest $W/manifest || die "no manifest at $BASE"
  fetch "$BASE" manifest.sig $W/manifest.sig || die "REFUSED: no signature (unsigned bundle)"
  signify-openbsd -V -p $PUB -m $W/manifest -x $W/manifest.sig >/dev/null 2>&1 || die "REFUSED: bad signature (manifest not signed by the owner's key, or changed)"
  echo "update: signature OK"
  NEWVER=$(sed -n 's/^version //p' $W/manifest)
  [ -n "$NEWVER" ] || die "REFUSED: manifest has no version"
  MIN=$(cat $STATE/min_version 2>/dev/null || echo 0)
  [ "$NEWVER" -gt "$RUNVER" ] 2>/dev/null || die "REFUSED: version $NEWVER is not newer than the running version $RUNVER"
  [ "$NEWVER" -ge "$MIN" ] 2>/dev/null || die "REFUSED: version $NEWVER is below the floor $MIN"
  # Kernel pinning: the signed manifest must name the kernel version (and list its modules).
  KV=$(sed -n 's/^kernel-version //p' $W/manifest)
  [ -n "$KV" ] || die "REFUSED: manifest has no kernel version line"
  echo "update: kernel version $KV, modules: $(sed -n 's/^modules *//p' $W/manifest | tr '\n' ' ')"
  # The bundle carries one kernel per slot; the manifest must list both, and only the other slot's is fetched.
  for f in kernel-a.efi kernel-b.efi; do
    [ -n "$(sed -n "s/^$f sha256 \([0-9a-f]*\) size .*/\1/p" $W/manifest)" ] || die "REFUSED: manifest does not list $f"
  done
  # The boot partition is mounted before anything is fetched or written.
  mount -t vfat "$(/sbin/findfs PARTLABEL=hubos-esp)" /boot/efi || die "cannot mount the boot partition"
  trap 'umount /boot/efi 2>/dev/null' EXIT
  rm -f /boot/efi/EFI/hubos/kernel-$OTHER.efi.new /boot/efi/EFI/hubos/kernel-recovery.efi.new
  # The separate recovery kernel is optional in the manifest and is installed only when its version is newer.
  RV=$(sed -n 's/^recovery-version //p' $W/manifest)
  RWANT=$(sed -n "s/^kernel-recovery.efi sha256 \([0-9a-f]*\) size .*/\1/p" $W/manifest)
  NEEDREC=
  if [ -n "$RV" ] || [ -n "$RWANT" ]; then
    { [ -n "$RV" ] && [ -n "$RWANT" ]; } || die "REFUSED: the manifest lists the recovery kernel only in part (it needs both recovery-version and kernel-recovery.efi)"
    case $RV in *[!0-9]*) die "REFUSED: recovery-version $RV is not a number";; esac
    INST=$(cat /boot/efi/EFI/hubos/recovery.version 2>/dev/null || echo 0)
    if [ "$RV" -gt "$INST" ]; then NEEDREC=1; echo "update: recovery kernel version $RV is newer than the installed $INST; it will be installed"
    else echo "update: recovery kernel version $RV is not newer than the installed $INST; left alone"; fi
  else
    echo "update: the manifest has no recovery kernel; recovery left alone"
  fi
  for f in kernel-$OTHER.efi rootfs.sqsh ${NEEDREC:+kernel-recovery.efi}; do
    want=$(sed -n "s/^$f sha256 \([0-9a-f]*\) size .*/\1/p" $W/manifest); [ -n "$want" ] || die "REFUSED: manifest does not list $f"
    echo "update: fetching $f"; fetch "$BASE" $f $W/$f || die "cannot fetch $f"
    got=$(sha256sum $W/$f | cut -d' ' -f1)
    [ "$got" = "$want" ] || die "REFUSED: $f does not match the signed hash (tampered or damaged)"
  done
  echo "update: hashes OK, version $NEWVER, writing to slot $OTHER"
  # Free space on the boot partition is checked BEFORE anything is written: no root, kernel or entry is
  # touched if the new kernel(s) would not fit.
  KSZ=$(stat -c %s $W/kernel-$OTHER.efi); RSZ=0; [ -n "$NEEDREC" ] && RSZ=$(stat -c %s $W/kernel-recovery.efi)
  FREE=$(df -B1 --output=avail /boot/efi | tail -n 1 | tr -d ' ')
  NEED=$((KSZ + RSZ + 1048576))
  echo "update: boot partition free space $FREE bytes, the new kernel(s) need $NEED (slot kernel $KSZ, recovery kernel $RSZ, plus 1 MiB)"
  [ "$FREE" -ge "$NEED" ] 2>/dev/null || die "FAILED: not enough free space on the boot partition (have $FREE bytes, need $NEED); nothing was written, the existing kernel and slot $OTHER are untouched"
  DEV=$(/sbin/findfs PARTLABEL=hubos-root-$OTHER) || die "no partition hubos-root-$OTHER"
  SZ=$(stat -c %s $W/rootfs.sqsh)
  # The write goes in 4 MiB pieces, with a line after each, so that a test can interrupt it at a known place.
  MB=$(( (SZ + 1048575) / 1048576 )); i=0
  while [ $i -lt $MB ]; do
    dd if=$W/rootfs.sqsh of=$DEV bs=1M skip=$i seek=$i count=4 conv=fsync,notrunc 2>/dev/null || die "write failed"
    i=$((i+4)); n=$i; [ $n -gt $MB ] && n=$MB; echo "update: wrote $n of $MB MiB to slot $OTHER"
  done
  [ "$(head -c $SZ $DEV | sha256sum | cut -d' ' -f1)" = "$(sed -n 's/^rootfs.sqsh sha256 \([0-9a-f]*\) .*/\1/p' $W/manifest)" ] || die "read-back check failed"
  echo "update: root written and verified"
  if ! cp $W/kernel-$OTHER.efi /boot/efi/EFI/hubos/kernel-$OTHER.efi.new || ! sync; then
    rm -f /boot/efi/EFI/hubos/kernel-$OTHER.efi.new; die "FAILED: cannot copy the kernel; the existing kernel is untouched"
  fi
  mv /boot/efi/EFI/hubos/kernel-$OTHER.efi.new /boot/efi/EFI/hubos/kernel-$OTHER.efi && sync
  echo "update: kernel installed"
  if [ -n "$NEEDREC" ]; then
    if ! cp $W/kernel-recovery.efi /boot/efi/EFI/hubos/kernel-recovery.efi.new || ! sync; then
      rm -f /boot/efi/EFI/hubos/kernel-recovery.efi.new; die "FAILED: cannot copy the recovery kernel; the existing one is untouched"
    fi
    mv /boot/efi/EFI/hubos/kernel-recovery.efi.new /boot/efi/EFI/hubos/kernel-recovery.efi && echo "$RV" > /boot/efi/EFI/hubos/recovery.version && sync
    echo "update: recovery kernel version $RV installed"
  fi
  umount /boot/efi; trap - EXIT
  ensure_entries
  efibootmgr -q -n "$(entry_num hubos-$OTHER)" || die "cannot set BootNext"
  rm -rf $W
  echo "update: installed version $NEWVER in slot $OTHER; BootNext set; reboot to try it"
}

confirm() {
  cur=$(efibootmgr | sed -n 's/^BootCurrent: //p'); first=$(efibootmgr | sed -n 's/^BootOrder: \([0-9A-F]*\).*/\1/p')
  mine=$(entry_num hubos-$SLOT)
  # A slot whose release is below the floor is never confirmed (the floor only goes down by "hubos-ctl rollback").
  old=$(cat $STATE/min_version 2>/dev/null || echo 0)
  if [ "$RUNVER" -lt "$old" ] 2>/dev/null; then
    die "confirm: REFUSED: release $RUNVER of slot $SLOT is below the floor $old; BootOrder and the floor are unchanged (to go back on purpose: hubos-ctl rollback REASON)"
  fi
  if [ "$cur" = "$mine" ] && [ "$first" = "$mine" ]; then echo "confirm: slot $SLOT is already the confirmed slot"; return 0; fi
  [ "$cur" = "$mine" ] || die "confirm: BootCurrent $cur is not slot $SLOT's entry ($mine); not confirming"
  efibootmgr -q -o "$mine,$(entry_num hubos-$OTHER),$(entry_num hubos-recovery)" || die "cannot set BootOrder"
  # The floor only goes up: the larger of the old floor and the running version.
  new=$RUNVER; [ "$old" -gt "$new" ] 2>/dev/null && new=$old
  mkdir -p $STATE; echo "$new" > $STATE/min_version; sync
  if [ "$new" = "$RUNVER" ]; then echo "confirm: boot of slot $SLOT (version $RUNVER) confirmed; floor is $new"
  else echo "confirm: boot of slot $SLOT (version $RUNVER) confirmed; floor stays at $new (it only goes up)"; fi
}

# The owner runs this on purpose to go back to an older release: it lowers the floor to the running release and
# makes the running slot first in BootOrder. It logs the old and new floor and the reason.
rollback() {
  [ -n "$*" ] || die "usage: hubos-ctl rollback REASON   (the reason is written to $STATE/rollback.log)"
  reason="$*"
  [ -n "$SLOT" ] && [ "$SLOT" != unknown ] || die "running slot unknown"
  cur=$(efibootmgr | sed -n 's/^BootCurrent: //p'); mine=$(entry_num hubos-$SLOT)
  [ "$cur" = "$mine" ] || die "rollback: BootCurrent $cur is not slot $SLOT's entry ($mine); boot the slot you want to keep through its own entry first"
  old=$(cat $STATE/min_version 2>/dev/null || echo 0)
  efibootmgr -q -o "$mine,$(entry_num hubos-$OTHER),$(entry_num hubos-recovery)" || die "cannot set BootOrder"
  mkdir -p $STATE; echo "$RUNVER" > $STATE/min_version
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) rollback: slot $SLOT release $RUNVER, floor $old -> $RUNVER, BootOrder first: $mine, reason: $reason" >> $STATE/rollback.log; sync
  echo "rollback: floor $old -> $RUNVER; slot $SLOT is now first in BootOrder; reason logged: $reason"
}

case "$1" in
  status) status;; ensure-entries) ensure_entries;; update) update "$2";; confirm) confirm;;
  rollback) shift; rollback "$@";;
  *) echo "usage: hubos-ctl status|ensure-entries|update BASE|confirm|rollback REASON"; exit 1;;
esac
