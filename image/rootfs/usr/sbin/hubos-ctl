#!/bin/sh
# hubos-ctl: boot entries, update, confirm. Slice 1 proposal (POSIX sh); not a decision.
# Subcommands:  status | ensure-entries | update BASE [SLOT] | confirm | rollback REASON | clear-failures
# It also runs in the recovery shell (the separate recovery kernel), where `update BASE [SLOT]` installs a signed
# bundle into the slot the owner names (default a).
PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DISK=${HUBOS_DISK:-/dev/vda}
KEYS=/etc/hubos/keys   # the update keyring: a manifest signed by ANY *.pub in this folder is accepted (docs/image.md, key rotation)
STATE=/config/hubos/state
SLOT=$(cat /run/hubos-slot 2>/dev/null)
OTHER=a; [ "$SLOT" = a ] && OTHER=b
RUNVER=$(sed -n 's/^version=//p' /etc/hubos-release)
RECOVERY=; grep -q '^flavor=recovery' /etc/hubos-release 2>/dev/null && RECOVERY=1
RECDIR=/usr/lib/hubos/recovery
# The boot-failure counter (the boot-loop breaker, stage 0): one EFI variable per counted failed boot, named
# HubosBootFail1, HubosBootFail2, ..., vendor GUID a0b7c0f5-4e7a-4d2b-9c61-5f0a1e3d8b72 (see image/stage0/init).
# The count is the number of those variables. Stage 0 creates them; a healthy boot (confirm) or a fresh install from
# recovery deletes them all (efivarfs files are immutable: chattr -i first).
BFD=/sys/firmware/efi/efivars; BFG=a0b7c0f5-4e7a-4d2b-9c61-5f0a1e3d8b72
bf_read() { n=0; for f in $BFD/HubosBootFail[0-9]*-$BFG; do [ -f "$f" ] && n=$((n+1)); done; echo $n; }
bf_wipe() { for f in $BFD/HubosBootFail[0-9]*-$BFG; do [ -f "$f" ] || continue; chattr -i "$f" 2>/dev/null; rm -f "$f"; done; [ "$(bf_read)" = 0 ]; }
bf_clear() { # a healthy boot clears the counter; failing to do so is reported, never fatal
  [ "$(bf_read)" = 0 ] && return 0
  if bf_wipe; then echo "confirm: boot-failure counter cleared"; else echo "confirm: WARNING cannot clear the boot-failure counter"; fi
}
bf_limit() {
  l=${HUBOS_BOOT_FAIL_LIMIT:-$(sed -n 's/^BOOT_FAIL_LIMIT=//p' /config/hubos/node.conf 2>/dev/null | tail -n 1 | tr -d "\"' ")}
  case $l in ''|*[!0-9]*) l=3;; esac; echo "$l"
}
die() { echo "hubos-ctl: $*" >&2; exit 2; }

entry_num() { efibootmgr 2>/dev/null | sed -n "s/^Boot\([0-9A-F]\{4\}\)\*\{0,1\}[[:space:]]$1[[:space:]].*/\1/p" | head -1; }

# BootOrder with the recovery entry directly after the two slot entries (firmware entries keep their place after it).
order_with_rec() {
  rn=$(entry_num hubos-recovery); a=$(entry_num hubos-a); b=$(entry_num hubos-b)
  out=; rest=
  for e in $(efibootmgr 2>/dev/null | sed -n 's/^BootOrder: //p' | tr ',' ' '); do
    case $e in
      "$rn") ;;
      "$a"|"$b") out="$out,$e" ;;
      *) rest="$rest,$e" ;;
    esac
  done
  echo "${out#,},$rn$rest"
}

ensure_entries() {
  [ -d /sys/firmware/efi/efivars ] || die "no EFI variables (not booted by UEFI?)"
  # None of the three entries carries load options. The a and b entries boot kernel-a.efi and kernel-b.efi, which
  # have their slot and root built into their own command lines. The recovery entry ALWAYS boots the separate
  # recovery kernel (kernel-recovery.efi), which needs neither slot's root. The recovery entry sits in BootOrder
  # directly after the two slot entries, so the firmware keeps it (docs/image.md).
  # Creating an entry puts it first in BootOrder, so remember the order and put it back afterwards.
  oldorder=$(efibootmgr 2>/dev/null | sed -n 's/^BootOrder: //p')
  created=
  for s in a b; do
    [ -n "$(entry_num hubos-$s)" ] && continue
    efibootmgr -q -c -d $DISK -p 1 -L hubos-$s -l "\\EFI\\hubos\\kernel-$s.efi" || die "cannot create entry $s"
    created=1
  done
  rn=$(entry_num hubos-recovery)
  if [ -n "$rn" ] && ! efibootmgr -v 2>/dev/null | grep "^Boot$rn" | grep -q 'kernel-recovery\.efi'; then
    efibootmgr -q -B -b "$rn" || die "cannot delete the old recovery entry"; rn=; created=1   # made by an earlier image: re-point it
  fi
  [ -n "$rn" ] || { efibootmgr -q -c -d $DISK -p 1 -L hubos-recovery -l "\\EFI\\hubos\\kernel-recovery.efi" || die "cannot create recovery entry"; created=1; }
  rn=$(entry_num hubos-recovery)
  if [ -z "$created" ] && echo "$oldorder" | grep -q "$rn"; then return 0; fi
  a=$(entry_num hubos-a); b=$(entry_num hubos-b)
  if [ -n "$oldorder" ] && echo "$oldorder" | grep -q "$a" && echo "$oldorder" | grep -q "$b"; then
    efibootmgr -q -o "$(echo "$oldorder" | sed "s/$rn,\{0,1\}//; s/,$//")" || die "cannot restore BootOrder"   # a confirmed order exists: keep it
    efibootmgr -q -o "$(order_with_rec)" || die "cannot put the recovery entry into BootOrder"
  else
    efibootmgr -q -o "$(entry_num hubos-$SLOT),$(entry_num hubos-$OTHER),$rn"  # first install: the running slot first, recovery last
  fi
}

status() {
  echo "slot=$SLOT release=$RUNVER"; efibootmgr 2>/dev/null | sed -n '/^Boot\(Current\|Next\|Order\)/p; /^Boot[0-9A-F]*\*\{0,1\}[[:space:]]hubos/s/\t.*//p'
  echo "min_version=$(cat $STATE/min_version 2>/dev/null || echo none)"
  echo "boot-failures=$(bf_read) limit=$(bf_limit)"
}

fetch() { # fetch BASE NAME DEST
  case "$1" in
    http://*) wget -q -O "$3" "$1/$2" || return 1 ;;
    *)        cp "$1/$2" "$3" || return 1 ;;
  esac
}

# Free space (bytes) of the mounted boot partition. POSIX df, so it also works with BusyBox in the recovery shell.
esp_free() { echo $(( $(df -kP /boot/efi | tail -n 1 | awk '{print $4}') * 1024 )); }

update() {
  BASE=$1; [ -n "$BASE" ] || die "usage: hubos-ctl update BASE [SLOT]"
  if [ -n "$RECOVERY" ]; then
    # In the recovery shell no slot is running: the owner names the slot to install into (default a).
    TARGET=${2:-a}
  else
    [ -n "$SLOT" ] && [ "$SLOT" != unknown ] || die "running slot unknown"
    TARGET=${2:-$OTHER}
    [ "$TARGET" != "$SLOT" ] || die "REFUSED: slot $TARGET is the running slot; an update is written to the other slot ($OTHER)"
  fi
  case $TARGET in a|b) ;; *) die "usage: hubos-ctl update BASE [a|b]";; esac
  OTHER=$TARGET   # the rest of this function writes to $OTHER
  if [ -n "$RECOVERY" ] && grep -q " /data " /proc/mounts; then W=/data/update; else W=/run/update; fi
  rm -rf $W; mkdir -p $W
  echo "update: fetching manifest from $BASE"
  fetch "$BASE" manifest $W/manifest || die "no manifest at $BASE"
  fetch "$BASE" manifest.sig $W/manifest.sig || die "REFUSED: no signature (unsigned bundle)"
  nkeys=0; signed_by=
  for k in $KEYS/*.pub; do [ -f "$k" ] && nkeys=$((nkeys+1)); done
  for k in $KEYS/*.pub; do
    [ -f "$k" ] || continue
    if signify-openbsd -V -p "$k" -m $W/manifest -x $W/manifest.sig >/dev/null 2>&1; then signed_by=$k; break; fi
  done
  [ "$nkeys" -gt 0 ] || die "REFUSED: there is no update key in $KEYS (nothing can be verified)"
  [ -n "$signed_by" ] || die "REFUSED: bad signature (manifest not signed by any of the $nkeys key(s) in $KEYS, or changed)"
  echo "update: signature OK (key $(basename "$signed_by" .pub), $nkeys key(s) in the keyring)"
  NEWVER=$(sed -n 's/^version //p' $W/manifest)
  [ -n "$NEWVER" ] || die "REFUSED: manifest has no version"
  MIN=$(cat $STATE/min_version 2>/dev/null || echo 0)
  if [ -n "$RECOVERY" ]; then
    # No release is running, so "newer than the running release" has no meaning here: a release below the floor
    # (the highest release ever confirmed) is refused; the floor's own release may be installed again.
    [ "$NEWVER" -ge "$MIN" ] 2>/dev/null || die "REFUSED: version $NEWVER is below the floor $MIN (recovery installs only releases at or above the floor)"
  else
    [ "$NEWVER" -gt "$RUNVER" ] 2>/dev/null || die "REFUSED: version $NEWVER is not newer than the running version $RUNVER"
    [ "$NEWVER" -ge "$MIN" ] 2>/dev/null || die "REFUSED: version $NEWVER is below the floor $MIN"
  fi
  # Kernel pinning: the signed manifest must name the kernel version (and list its modules).
  KV=$(sed -n 's/^kernel-version //p' $W/manifest)
  [ -n "$KV" ] || die "REFUSED: manifest has no kernel version line"
  echo "update: kernel version $KV, modules: $(sed -n 's/^modules *//p' $W/manifest | tr '\n' ' ')"
  # The bundle carries one kernel per slot; the manifest must list both, and only the target slot's is fetched.
  for f in kernel-a.efi kernel-b.efi; do
    [ -n "$(sed -n "s/^$f sha256 \([0-9a-f]*\) size .*/\1/p" $W/manifest)" ] || die "REFUSED: manifest does not list $f"
  done
  # The recovery kernel is NOT touched here. It travels inside the new root (/usr/lib/hubos/recovery), the manifest
  # lists its hash and version, and the confirm step installs it after a healthy boot. Optional in the manifest.
  RV=$(sed -n 's/^recovery-version //p' $W/manifest)
  RWANT=$(sed -n "s/^kernel-recovery.efi sha256 \([0-9a-f]*\) size .*/\1/p" $W/manifest)
  if [ -n "$RV" ] || [ -n "$RWANT" ]; then
    { [ -n "$RV" ] && [ -n "$RWANT" ]; } || die "REFUSED: the manifest lists the recovery kernel only in part (it needs both recovery-version and kernel-recovery.efi)"
    case $RV in *[!0-9]*) die "REFUSED: recovery-version $RV is not a number";; esac
    echo "update: the manifest lists recovery kernel version $RV; it is installed at the confirm step, not now"
  else
    echo "update: the manifest has no recovery kernel; recovery left alone"
  fi
  # The boot partition is mounted before anything is fetched or written.
  mount -t vfat "$(/sbin/findfs PARTLABEL=hubos-esp)" /boot/efi || die "cannot mount the boot partition"
  trap 'umount /boot/efi 2>/dev/null; umount /run/newroot-check 2>/dev/null' EXIT
  rm -f /boot/efi/EFI/hubos/kernel-$OTHER.efi.new
  for f in kernel-$OTHER.efi rootfs.sqsh; do
    want=$(sed -n "s/^$f sha256 \([0-9a-f]*\) size .*/\1/p" $W/manifest); [ -n "$want" ] || die "REFUSED: manifest does not list $f"
    echo "update: fetching $f"; fetch "$BASE" $f $W/$f || die "cannot fetch $f"
    got=$(sha256sum $W/$f | cut -d' ' -f1)
    [ "$got" = "$want" ] || die "REFUSED: $f does not match the signed hash (tampered or damaged)"
  done
  echo "update: hashes OK, version $NEWVER, writing to slot $OTHER"
  # Free space on the boot partition is checked BEFORE anything is written: no root, kernel or entry is
  # touched if the new kernel would not fit.
  KSZ=$(stat -c %s $W/kernel-$OTHER.efi)
  FREE=$(esp_free)
  NEED=$((KSZ + 1048576))
  echo "update: boot partition free space $FREE bytes, the new kernel needs $NEED (kernel $KSZ plus 1 MiB)"
  [ "$FREE" -ge "$NEED" ] 2>/dev/null || die "FAILED: not enough free space on the boot partition (have $FREE bytes, need $NEED); nothing was written, the existing kernel and slot $OTHER are untouched"
  DEV=$(/sbin/findfs PARTLABEL=hubos-root-$OTHER) || die "no partition hubos-root-$OTHER"
  SZ=$(stat -c %s $W/rootfs.sqsh)
  # The write goes in 4 MiB pieces, with a line after each, so that a test can interrupt it at a known place.
  MB=$(( (SZ + 1048575) / 1048576 )); i=0
  while [ $i -lt $MB ]; do
    dd if=$W/rootfs.sqsh of=$DEV bs=1M skip=$i seek=$i count=4 conv=fsync,notrunc 2>/dev/null || die "write failed"
    i=$((i+4)); n=$i; [ $n -gt $MB ] && n=$MB; echo "update: wrote $n of $MB MiB to slot $OTHER"
  done
  [ "$(head -c $SZ $DEV | sha256sum | cut -d' ' -f1)" = "$(sed -n 's/^rootfs.sqsh sha256 \([0-9a-f]*\) .*/\1/p' $W/manifest)" ] || die "read-back check failed"
  echo "update: root written and verified"
  if [ -n "$RV" ]; then
    # The recovery kernel inside the written root must be the file the signed manifest lists.
    mkdir -p /run/newroot-check
    mount -t squashfs -o ro "$DEV" /run/newroot-check || die "FAILED: cannot mount the written root to check its recovery kernel"
    rgot=$(sha256sum /run/newroot-check$RECDIR/kernel-recovery.efi 2>/dev/null | cut -d' ' -f1)
    rver=$(cat /run/newroot-check$RECDIR/recovery.version 2>/dev/null)
    umount /run/newroot-check
    { [ "$rgot" = "$RWANT" ] && [ "$rver" = "$RV" ]; } || die "REFUSED: the recovery kernel inside the new root does not match the manifest (hash ${rgot:-none}, version ${rver:-none}; manifest says $RWANT, $RV); BootNext is not set"
    echo "update: the recovery kernel inside the new root matches the manifest (version $RV)"
  fi
  if ! cp $W/kernel-$OTHER.efi /boot/efi/EFI/hubos/kernel-$OTHER.efi.new || ! sync; then
    rm -f /boot/efi/EFI/hubos/kernel-$OTHER.efi.new; die "FAILED: cannot copy the kernel; the existing kernel is untouched"
  fi
  mv /boot/efi/EFI/hubos/kernel-$OTHER.efi.new /boot/efi/EFI/hubos/kernel-$OTHER.efi && sync
  echo "update: kernel installed"
  umount /boot/efi; trap - EXIT
  ensure_entries
  efibootmgr -q -n "$(entry_num hubos-$OTHER)" || die "cannot set BootNext"
  if [ -n "$RECOVERY" ]; then
    # a fresh install starts with a clean count
    if [ "$(bf_read)" != 0 ]; then bf_wipe && echo "update: boot-failure counter cleared (fresh install)" || echo "update: WARNING cannot clear the boot-failure counter"; fi
  fi
  rm -rf $W
  echo "update: installed version $NEWVER in slot $OTHER; BootNext set; reboot to try it"
}

# The recovery kernel travels inside the root of every release (/usr/lib/hubos/recovery/kernel-recovery.efi and
# recovery.version). After a HEALTHY boot the confirm step installs it on the boot partition if its file differs from
# the installed one and its version is not lower than the installed one: free-space check first, copy to a temporary name, sync, compare, atomic rename.
# Nothing here is fatal: the boot is already confirmed.
install_recovery() {
  [ -f $RECDIR/kernel-recovery.efi ] && [ -f $RECDIR/recovery.version ] || { echo "confirm: this release carries no recovery kernel; recovery left alone"; return 0; }
  rv=$(cat $RECDIR/recovery.version)
  case $rv in ''|*[!0-9]*) echo "confirm: recovery kernel NOT installed: bad recovery.version '$rv'"; return 0;; esac
  mount -t vfat "$(/sbin/findfs PARTLABEL=hubos-esp)" /boot/efi 2>/dev/null || { echo "confirm: recovery kernel NOT installed: cannot mount the boot partition"; return 0; }
  inst=$(cat /boot/efi/EFI/hubos/recovery.version 2>/dev/null || echo 0)
  case $inst in ''|*[!0-9]*) inst=0;; esac
  # Rule: install when the file differs from the installed one AND the version is not lower (never a downgrade).
  # The same version with a different file DOES install (a key-rotation release that forgot to bump the version).
  if [ "$rv" -lt "$inst" ]; then
    echo "confirm: recovery kernel version $rv is lower than the installed $inst; never a downgrade, left alone"; umount /boot/efi; return 0
  fi
  have=$(sha256sum /boot/efi/EFI/hubos/kernel-recovery.efi 2>/dev/null | cut -d' ' -f1)
  if [ "$have" = "$(sha256sum $RECDIR/kernel-recovery.efi | cut -d' ' -f1)" ]; then
    echo "confirm: recovery kernel version $rv is the same file as the installed one; left alone"; umount /boot/efi; return 0
  fi
  sz=$(stat -c %s $RECDIR/kernel-recovery.efi); need=$((sz + 1048576)); free=$(esp_free)
  if [ "$free" -lt "$need" ]; then
    echo "confirm: recovery kernel NOT installed: not enough free space on the boot partition (have $free bytes, need $need); the installed recovery kernel is untouched"; umount /boot/efi; return 0
  fi
  D=/boot/efi/EFI/hubos
  rm -f $D/kernel-recovery.efi.new $D/recovery.version.new
  if cp $RECDIR/kernel-recovery.efi $D/kernel-recovery.efi.new && sync \
     && [ "$(sha256sum $D/kernel-recovery.efi.new | cut -d' ' -f1)" = "$(sha256sum $RECDIR/kernel-recovery.efi | cut -d' ' -f1)" ] \
     && mv $D/kernel-recovery.efi.new $D/kernel-recovery.efi && echo "$rv" > $D/recovery.version.new && mv $D/recovery.version.new $D/recovery.version && sync; then
    echo "confirm: recovery kernel version $rv installed (was $inst)"
  else
    rm -f $D/kernel-recovery.efi.new $D/recovery.version.new
    echo "confirm: recovery kernel NOT installed: copy failed; the installed recovery kernel is untouched or was replaced whole"
  fi
  umount /boot/efi
}

confirm() {
  cur=$(efibootmgr | sed -n 's/^BootCurrent: //p'); first=$(efibootmgr | sed -n 's/^BootOrder: \([0-9A-F]*\).*/\1/p')
  mine=$(entry_num hubos-$SLOT)
  # A slot whose release is below the floor is never confirmed (the floor only goes down by "hubos-ctl rollback").
  old=$(cat $STATE/min_version 2>/dev/null || echo 0)
  if [ "$RUNVER" -lt "$old" ] 2>/dev/null; then
    die "confirm: REFUSED: release $RUNVER of slot $SLOT is below the floor $old; BootOrder and the floor are unchanged (to go back on purpose: hubos-ctl rollback REASON)"
  fi
  if [ "$cur" = "$mine" ] && [ "$first" = "$mine" ]; then echo "confirm: slot $SLOT is already the confirmed slot"; bf_clear; install_recovery; return 0; fi
  [ "$cur" = "$mine" ] || die "confirm: BootCurrent $cur is not slot $SLOT's entry ($mine); not confirming"
  efibootmgr -q -o "$mine,$(entry_num hubos-$OTHER),$(entry_num hubos-recovery)" || die "cannot set BootOrder"
  # The floor only goes up: the larger of the old floor and the running version.
  new=$RUNVER; [ "$old" -gt "$new" ] 2>/dev/null && new=$old
  mkdir -p $STATE; echo "$new" > $STATE/min_version; sync
  if [ "$new" = "$RUNVER" ]; then echo "confirm: boot of slot $SLOT (version $RUNVER) confirmed; floor is $new"
  else echo "confirm: boot of slot $SLOT (version $RUNVER) confirmed; floor stays at $new (it only goes up)"; fi
  bf_clear
  install_recovery
}

clear_failures() {
  [ "$(bf_read)" = 0 ] && { echo "clear-failures: boot-failure counter is 0"; return 0; }
  bf_wipe && echo "clear-failures: boot-failure counter is 0" || die "cannot delete the boot-failure variables"
}

# The owner runs this on purpose to go back to an older release: it lowers the floor to the running release and
# makes the running slot first in BootOrder. It logs the old and new floor and the reason.
rollback() {
  [ -n "$*" ] || die "usage: hubos-ctl rollback REASON   (the reason is written to $STATE/rollback.log)"
  reason="$*"
  [ -n "$SLOT" ] && [ "$SLOT" != unknown ] || die "running slot unknown"
  cur=$(efibootmgr | sed -n 's/^BootCurrent: //p'); mine=$(entry_num hubos-$SLOT)
  [ "$cur" = "$mine" ] || die "rollback: BootCurrent $cur is not slot $SLOT's entry ($mine); boot the slot you want to keep through its own entry first"
  old=$(cat $STATE/min_version 2>/dev/null || echo 0)
  efibootmgr -q -o "$mine,$(entry_num hubos-$OTHER),$(entry_num hubos-recovery)" || die "cannot set BootOrder"
  mkdir -p $STATE; echo "$RUNVER" > $STATE/min_version
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) rollback: slot $SLOT release $RUNVER, floor $old -> $RUNVER, BootOrder first: $mine, reason: $reason" >> $STATE/rollback.log; sync
  echo "rollback: floor $old -> $RUNVER; slot $SLOT is now first in BootOrder; reason logged: $reason"
}

case "$1" in
  status) status;; ensure-entries) ensure_entries;; update) update "$2" "$3";; confirm) confirm;; clear-failures) clear_failures;;
  rollback) shift; rollback "$@";;
  *) echo "usage: hubos-ctl status|ensure-entries|update BASE [SLOT]|confirm|rollback REASON|clear-failures"; exit 1;;
esac
