#!/sbin/openrc-run
supervisor=supervise-daemon
name=waybar
command=/bin/follow-driftwm
command_args="waybar -wait /run/dw/wayland-1,/run/dw/bus -notify 3"
notify=fd:3
respawn_delay=1
respawn_max=10
respawn_period=60
output_logger="/opt/s6/bin/s6-log -b n5 s100000 /var/log/waybar"
error_log=/dev/null
start_pre() { mkdir -p /var/log/waybar; }
depend() {
	need driftwm dbus
}
