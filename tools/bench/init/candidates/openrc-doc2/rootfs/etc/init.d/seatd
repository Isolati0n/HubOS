#!/sbin/openrc-run
supervisor=supervise-daemon
name=seatd
command=/bin/seatd
command_args="-log 2 -notify 3"
notify=fd:3
respawn_delay=1
retry="SIGTERM/5/SIGKILL/5"
respawn_max=0
output_logger="/opt/s6/bin/s6-log -b n5 s100000 /var/log/seatd"
error_log=/dev/null
start_pre() { mkdir -p /var/log/seatd; }
depend() {
	:
}
