#!/bin/sh
# restart-limit SERVICE : called by the finish script of a service (BENCH CODE, a test helper, not the product's).
# Follow-up 8 version (s6rc-par-wd4d). Rule of the owner: 5 deaths within 60 s -> the service is STOPPED (finish exits 125, documented:
# SOURCE s6 2.15.1.0 doc/servicedir.html), an alert file is written, and for driftwm also the marker the image's follow-driftwm reads.
# History: its own small file /run/hubos/restarts/SERVICE, one line per death = seconds on the BOOT clock (/proc/uptime, in
# hundredths, not changed by setting the wall clock), at most the last 5 lines, written atomically (temporary file, then rename).
# It does NOT read the supervisor's death tally (that one uses the wall clock). A requested stop (s6-svc -d clears "wanted up"
# before it signals) is not a crash: nothing is recorded. The boot clock never goes backwards, so the span cannot be negative; if it
# ever were (a damaged file), the case counts as "not within 60 s".
svc=$1
dir=/run/hubos/restarts; alerts=/run/hubos/alerts; marker=/run/hub/driftwm-gave-up
[ "$(s6-svstat -o wantedup "/run/service/$svc" 2>/dev/null)" = true ] || exit 0
mkdir -p "$dir" "$alerts"
now=$(cut -d' ' -f1 /proc/uptime | tr -d .)
{ tail -n 4 "$dir/$svc" 2>/dev/null; echo "$now"; } > "$dir/$svc.new" && mv -f "$dir/$svc.new" "$dir/$svc"
n=$(wc -l < "$dir/$svc"); first=$(head -n 1 "$dir/$svc")
span=$((now - first))
echo "restart-limit: $svc death $n in the history; the last $n span $span hundredths of a second on the boot clock"
if [ "$n" -ge 5 ] && [ "$span" -ge 0 ] && [ "$span" -le 6000 ]; then
  if [ "$svc" = driftwm ]; then mkdir -p /run/hub && : > "$marker"; fi
  echo "$svc stopped: tried 5 times in 60 s" > "$alerts/$svc.new" && mv -f "$alerts/$svc.new" "$alerts/$svc"
  echo "restart-limit: $svc stopped for good (alert written$( [ "$svc" = driftwm ] && echo ', marker written'))"
  exit 125
fi
exit 0
