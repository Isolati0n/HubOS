#!/bin/sh
# hub-retry SERVICE : the person's command (TEST HOOK, follow-up 6, Part C; the product's command is not designed). Removes the alert,
# clears the death tally of the service (s6-svdt-clear, documented) and starts it (s6-svc -u).
[ -n "$1" ] || { echo "usage: hub-retry SERVICE" >&2; exit 2; }
rm -f "/run/hubos/alerts/$1"
s6-svdt-clear "/run/service/$1"
exec s6-svc -u "/run/service/$1"
