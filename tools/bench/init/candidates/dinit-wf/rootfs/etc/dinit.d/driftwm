type = process
command = /bin/driftwm --backend udev -mem 100 -wait /run/seatd.sock,/run/udev/ready -notify 3
restart = true
restart-delay = 1.0
restart-limit-count = 0
log-type = buffer
ready-notification = pipefd:3
waits-for = seatd
waits-for = udevd
oom-score-adj = -900
nice = -5
run-in-cgroup = /hub
