#!/bin/sh
# EXPERIMENT (step 5): the session bus, hubd and Waybar, started by hand from the serial shell (not an s6 service).
export XDG_RUNTIME_DIR=/run/dw WAYLAND_DISPLAY=wayland-1 LC_ALL=C.UTF-8 HOME=/root
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/dw/bus
mkdir -p /run/hubos /var/lib/dbus
dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork --print-pid
hubd serve --inventory /etc/hubos/inventory.toml --viewers /etc/hubos/viewers.toml --bar-height 30 > /run/hubos/hubd.log 2>&1 &
sleep 2
waybar -c /etc/hubos/waybar.json -s /etc/hubos/waybar.css -l info > /run/hubos/waybar.log 2>&1 &
echo started
