#!/bin/sh
# WORKAROUND, experiment only: write the few udev database entries libinput and smithay need, because no udevd runs
# (docs/proposals/phase-b-desktop.md). One file per device node in /run/udev/data/, named c<major>:<minor>.
mkdir -p /run/udev/data
for ev in /sys/class/input/event*; do
  [ -d "$ev" ] || continue
  dev=$(cat "$ev/dev"); in=$(basename "$(readlink -f "$ev/device")"); name=$(cat "$ev/device/name" 2>/dev/null)
  case "$name" in
    *eyboard*) t="E:ID_INPUT_KEY=1
E:ID_INPUT_KEYBOARD=1" ;;
    *ablet*)   t="E:ID_INPUT_MOUSE=1
E:ID_INPUT_TABLET=1" ;;
    *ouse*|*ointer*) t="E:ID_INPUT_MOUSE=1" ;;
    *) t= ;;
  esac
  [ -n "$t" ] || continue
  printf 'I:1\nE:ID_INPUT=1\n%s\nG:seat\nQ:seat\n' "$t" > "/run/udev/data/c$dev"
  printf 'I:1\nE:ID_INPUT=1\n%s\nG:seat\nQ:seat\n' "$t" > "/run/udev/data/+input:$in"
  echo "mkudevdb: $name -> c$dev"
done
for c in /sys/class/drm/card[0-9]; do
  [ -d "$c" ] || continue
  dev=$(cat "$c/dev")
  printf 'I:1\nG:seat\nG:master-of-seat\nQ:seat\nQ:master-of-seat\n' > "/run/udev/data/c$dev"
  echo "mkudevdb: $(basename $c) -> c$dev"
done
